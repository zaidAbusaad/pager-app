# Copy this file to .env and adjust if needed. Never commit .env.
DATABASE_URL="postgresql://pager:pager@localhost:5432/pager"

# Production (set these in your host's dashboard, not in this file):
#   DATABASE_URL = the POOLED connection string (host contains "-pooler"),
#                  with ?sslmode=require. The running app uses this one.
#   DIRECT_URL   = the DIRECT connection string (no "-pooler"). Only database
#                  migrations use it. Leave it unset on your own PC.
